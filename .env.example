# Host de Ollama (por defecto local)
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo recomendado para RTX 4060 8GB
NEMOTRON_MODEL=nemotron-3-nano:4b

# Carpeta de trabajo del agente (rutas relativas se resuelven aquí)
NEMOTRON_WORKSPACE=./workspace

# Activar reasoning/thinking del modelo (true/false)
NEMOTRON_THINK=true

# Máximo de iteraciones tool-calling por mensaje
NEMOTRON_MAX_STEPS=12
